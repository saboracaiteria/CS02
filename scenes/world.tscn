[sub_resource type="Shader" id="Shader_vaporwave"]
code = "shader_type canvas_item;
uniform float speed : hint_range(0.1, 5.0) = 0.6;
void fragment() {
    vec2 uv = UV;
    vec3 bg = mix(vec3(0.01, 0.02, 0.06), vec3(0.04, 0.01, 0.08), uv.y);
    float grid_x = abs(sin(uv.x * 28.0 - TIME * speed * 0.2)) * 0.04;
    float grid_y = abs(sin(uv.y * 16.0 + TIME * speed)) * 0.06;
    float grid = max(grid_x, grid_y);
    vec3 grid_color = vec3(0.0, 0.7, 1.0);
    bg = mix(bg, grid_color, grid * smoothstep(0.3, 1.0, uv.y));
    float horizon = smoothstep(0.28, 0.32, uv.y);
    vec3 horizon_glow = vec3(1.0, 0.5, 0.05) * 0.35 * (1.0 - abs(uv.x - 0.5) * 2.5);
    bg = mix(bg + horizon_glow * (1.0 - horizon), bg, horizon);
    float vign = 1.0 - smoothstep(0.3, 1.0, length((uv - 0.5) * vec2(1.4, 1.8)));
    COLOR = vec4(bg * vign, 1.0);
}"

